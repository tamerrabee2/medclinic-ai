# =============================================
# MedClinic AI — Environment Variables Example
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================

# Application
APPLICATION_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
ASPNETCORE_ENVIRONMENT=Development

# Database
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=medclinic;Username=postgres;Password=your_password

# JWT
JWT_SECRET=your_super_secret_key_min_32_chars_here
JWT_ISSUER=MedClinicAI
JWT_AUDIENCE=MedClinicAI
JWT_EXPIRES_MINUTES=60
JWT_REFRESH_EXPIRES_DAYS=30

# Redis
REDIS_CONNECTION_STRING=localhost:6379

# Storage
# Options: local | s3 | azure | supabase
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
# S3
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
# Azure Blob
STORAGE_AZURE_CONNECTION_STRING=
STORAGE_AZURE_CONTAINER=

# AI Provider
# Options: mock | local | openai | gemini | anthropic
AI_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Local AI (Ollama)
LOCAL_AI_BASE_URL=http://localhost:11434
LOCAL_AI_MODEL=llama3.2

# Email
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@medclinic-ai.example.com
SMTP_FROM_NAME=MedClinic AI

# Hangfire
HANGFIRE_DASHBOARD_ENABLED=true
HANGFIRE_DASHBOARD_PATH=/hangfire
