{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "MedClinicAI",
    "Audience": "MedClinicAI",
    "AccessTokenExpiryMinutes": "60",
    "RefreshTokenExpiryDays": "30"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001"
    ]
  },
  "Storage": {
    "Provider": "Local",
    "LocalPath": "uploads",
    "BaseUrl": "/files"
  },
  "AI": {
    "Provider": "Mock",
    "OpenAI": {
      "ApiKey": "",
      "Model": "gpt-4o"
    },
    "Gemini": {
      "ApiKey": "",
      "Model": "gemini-1.5-pro"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
